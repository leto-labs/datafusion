10 NULL true NULL
11 NULL false NULL
12 NULL NULL NULL
13 true true NULL
2 NULL false NULL
3 NULL NULL NULL
4 NULL NULL false
5 NULL false NULL
6 NULL true NULL
7 NULL NULL NULL
8 NULL true NULL
9 NULL NULL NULL

