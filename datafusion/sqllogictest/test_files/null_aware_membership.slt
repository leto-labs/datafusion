# 204: pinned corpus NOT IN OR regression
query IT rowsort
SELECT id,v FROM (VALUES (1,'a'),(2,'b'),(3,'c'),(4,'d'),(NULL,'e')) outer_table(id,v) WHERE id NOT IN (SELECT id FROM (VALUES (2),(4)) inner_table_no_null(id)) OR id NOT IN (SELECT id FROM (VALUES (1),(3)) inner_table2(id));
