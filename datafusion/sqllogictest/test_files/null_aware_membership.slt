# 197: multiple membership expressions and CASE
query IBBB rowsort
SELECT p.id,p.x IN (SELECT y FROM ni_set WHERE g=1),p.x NOT IN (SELECT y FROM ni_set WHERE g=2),CASE WHEN p.flag THEN p.x IN (SELECT y FROM ni_set WHERE g=3) ELSE p.x NOT IN (SELECT y FROM ni_set WHERE g=4) END FROM ni_probe p;
